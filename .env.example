# Optional: absolute paths. Defaults match this workspace.
# PARALLAX_DATA_DIR=/absolute/path/to/Helper/data
# PARALLAX_RESEARCH_ROOT=/absolute/path/to/EvalGamingUnderPressureTraining

# Optional: LLM judges (Traces → Evaluators). The key can also be saved from that page.
# With no key, Parallax contacts nobody. A judge run sends trace content to OpenRouter.
# OPENROUTER_API_KEY=sk-or-v1-...
# LLM_JUDGE_MODEL=openai/gpt-6-luna          # default text model
# COLUMN_DEFAULT_MODEL=typesafe/jev-1.13     # default decision model
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
