# Optional: absolute paths. Defaults match this workspace.
# PARALLAX_DATA_DIR=/absolute/path/to/Helper/data
# PARALLAX_RESEARCH_ROOT=/absolute/path/to/EvalGamingUnderPressureTraining

# Optional: LLM judges (Traces → Evaluators) and the workspace chat (Ask). The key can also be
# saved from the Evaluators page. With no key, Parallax contacts nobody. A judge run sends trace
# content to OpenRouter; a chat answer sends the question and the passages the model reads.
# OPENROUTER_API_KEY=sk-or-v1-...
# No stored key, on a Google Compute Engine machine that an OpenRouter federation policy names:
# each call uses a short-lived key for the identity of the machine. A stored key wins over it.
# OPENROUTER_FEDERATION_POLICY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# LLM_JUDGE_MODEL=openai/gpt-6-luna          # default text model
# COLUMN_DEFAULT_MODEL=typesafe/jev-1.13     # default decision model
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
